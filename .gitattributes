*.sh text eol=lf
*.pl text eol=lf
*.pm text eol=lf
*.py text eol=lf
*.sas text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
integrations/vscode/** text eol=lf
integrations/vscode/validation/*.log whitespace=-blank-at-eol,-blank-at-eof
*.cmd text eol=crlf

# Frozen PoC programs and fixtures retain the bytes used in the comparison.
examples/poc/programs/** -text -whitespace
examples/poc/inputs/** -text -whitespace

# Retain upstream formatting in the explicitly traced macro test snapshots.
tests/library_workflows500/macros/*.sas -text -whitespace
tests/online_samples500/macros/*.sas -text -whitespace
tests/library_workflows500/inputs/*.tsv text eol=lf
tests/online_samples500/inputs/*.csv text eol=lf
tests/library_workflows500/manifest.json text eol=lf
tests/online_samples500/manifest.json text eol=lf
docs/NEW_WORKFLOW_*.json text eol=lf
tests/library_workflows500/inputs/*.gz binary
tests/library_workflows500/inputs/*.zip binary
